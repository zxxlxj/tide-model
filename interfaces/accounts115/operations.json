  "acquire": {
    "summary": "取得当前调用专用的连接凭据句柄",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "来自 115 的数字账号 UID，以字符串表示"
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式",
          "enum": [
            "cookie",
            "bearer"
          ]
        }
      },
      "required": [
        "uuid",
        "kind"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "直接传给连接器的账号及凭据",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "来自 115 的数字账号 UID，以字符串表示"
        },
        "credential": {
          "type": [
            "object"
          ],
          "description": "短期凭据",
          "properties": {
            "kind": {
              "type": [
                "string"
              ],
              "description": "连接方式",
              "enum": [
                "cookie",
                "bearer"
              ]
            },
            "handle": {
              "type": [
                "string"
              ],
              "description": "仅限当前调用者操作期间使用"
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "example": {
      "args": {
        "uuid": "12345",
        "kind": "cookie"
      },
      "result": {
        "uuid": "12345",
        "credential": {
          "kind": "cookie",
          "handle": "sample"
        }
      }
    }
  },
  "begin": {
    "summary": "申请扫码登录",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "来自 115 的数字账号 UID，以字符串表示"
        },
        "kind": {
          "type": [
            "string"
          ],
          "description": "连接方式",
          "enum": [
            "cookie",
            "bearer"
          ]
        },
        "appId": {
          "type": [
            "string"
          ],
          "description": "Open 扫码必填，开发者 AppID"
        },
        "app": {
          "type": [
            "string"
          ],
          "description": "CK 登录设备，默认 alipaymini",
          "enum": [
            "alipaymini",
            "wechatmini",
            "ios",
            "bios",
            "115ios",
            "android",
            "bandroid",
            "115android",
            "harmony",
            "ipad",
            "bipad",
            "115ipad",
            "qios",
            "qipad",
            "qandroid",
            "web",
            "desktop",
            "windows",
            "os_windows",
            "mac",
            "os_mac",
            "linux",
            "os_linux",
            "tv",
            "apple_tv"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "扫码会话",
      "properties": {
        "ticket": {
          "type": [
            "string"
          ],
          "description": "加密会话，传给 poll"
        },
        "qr": {
          "type": [
            "string"
          ],
          "description": "用 115 App 扫描的二维码内容"
        },
        "expires": {
          "type": [
            "integer"
          ],
          "description": "过期 Unix 毫秒"
        },
        "client": {
          "type": [
            "string"
          ],
          "description": "CK 的设备标识或 Open 的 AppID，手动填写可留空"
        }
      },
      "required": []
    },
    "example": {
      "args": {
        "kind": "cookie"
      },
      "result": {
        "ticket": "sample",
        "qr": "https://115.com/scan/dg-example",
        "expires": 1
      }
    }
  },
  "poll": {
    "summary": "查询手机扫码和确认状态",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "ticket": {
          "type": [
            "string"
          ],
          "description": "begin 返回的会话"
        }
      },
      "required": [
        "ticket"
      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "扫码状态",
      "properties": {
        "status": {
          "type": [
            "string"
          ],
          "description": "扫码状态",
          "enum": [
            "waiting",
            "scanned",
            "confirmed",
            "expired",
            "cancelled"
          ]
        }
      },
      "required": []
    },
    "example": {
      "args": {
        "ticket": "sample"
      },
      "result": {
        "status": "confirmed"
      }
    }
  },
  "exchange": {
    "summary": "将已确认的授权换成表单凭据",
