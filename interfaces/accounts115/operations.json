        "expires": 0
      }
    }
  },
  "profile": {
    "summary": "读取本地资料，不连接 115",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "uuid": {
          "type": [
            "string"
          ],
          "description": "来自 115 的数字账号 UID，以字符串表示"
