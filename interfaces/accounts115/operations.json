            "string"
          ],
          "description": "CK 或 access_token"
        },
        "refreshToken": {
          "type": [
            "string"
          ],
          "description": "可选刷新令牌"
        },
        "expires": {
          "type": [
            "integer"
          ],
          "description": "Open 访问令牌到期的 Unix 毫秒，0 表示未知"
        }
      },
      "required": [
        "value"
      ]
    },
    "example": {
      "args": {
        "uuid": "12345",
