      ]
    },
    "output": {
      "type": [
        "object"
      ],
      "description": "仅返回给管理员的凭据，可修改后传给 configure",
      "properties": {
        "value": {
          "type": [
            "string"
          ],
          "description": "CK 或 access_token"
        },
        "refreshToken": {
          "type": [
            "string"
          ],
          "description": "可选刷新令牌"
        },
        "expires": {
          "type": [
            "integer"
          ],
          "description": "Open 访问令牌到期的 Unix 毫秒，0 表示未知"
        },
        "client": {
          "type": [
            "string"
          ],
          "description": "CK 的设备标识或 Open 的 AppID，手动填写可留空"
        }
      },
      "required": [
        "value"
      ]
    },
    "example": {
      "args": {
        "ticket": "sample"
      },
      "result": {
        "value": "example-token",
        "refreshToken": "",
        "expires": 0
      }
    }
  },
