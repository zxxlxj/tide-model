{
  "list": {
    "summary": "列出账号连接",
    "input": {
      "type": [
        "object"
      ],
      "description": "调用参数",
      "properties": {
        "offset": {
          "type": [
            "integer"
          ],
          "description": "行偏移，默认 0"
        },
        "limit": {
          "type": [
            "integer"
          ],
          "description": "1–100，默认 100"
        }
      },
      "required": []
    },
    "output": {
      "type": [
        "array"
      ],
      "description": "按 UID、连接方式排序",
      "items": {
        "type": [
          "object"
        ],
        "description": "一条连接的公开信息",
        "properties": {
          "uuid": {
            "type": [
              "string"
            ],
            "description": "来自 115 的数字账号 UID，以字符串表示"
          },
          "kind": {
            "type": [
              "string"
            ],
            "description": "连接方式",
            "enum": [
              "cookie",
              "bearer"
            ]
          },
          "label": {
            "type": [
              "string"
            ],
            "description": "显示名称"
          },
          "note": {
            "type": [
              "string"
            ],
            "description": "账号备注"
          },
          "updated": {
            "type": [
              "integer"
            ],
            "description": "Unix 毫秒"
          },
          "client": {
            "type": [
              "string"
            ],
            "description": "CK 的设备标识或 Open 的 AppID，手动填写可留空"
          },
          "profile": {
            "type": [
              "object",
              "null"
            ],
            "description": "账号资料快照；尚未同步时为 null",
            "properties": {
              "nickname": {
                "type": [
                  "string"
                ],
                "description": "115 昵称，与本地备注名独立"
              },
              "avatarUrl": {
                "type": [
                  "string"
                ],
                "description": "官方头像地址，可通过 avatar 读取本地缩略图"
              },
              "hasAvatar": {
                "type": [
                  "boolean"
                ],
                "description": "已缓存有效头像"
              },
              "vip": {
                "type": [
                  "object"
                ],
                "description": "会员资料",
                "properties": {
                  "active": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "当前会员状态，未知为 null"
                  },
                  "level": {
                    "type": [
                      "string"
                    ],
                    "description": "上游返回的会员等级名称"
                  },
                  "permanent": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "长期会员标记"
                  },
                  "expiresAt": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "会员到期 Unix 毫秒"
                  },
                  "expiresOn": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "115 显示的会员到期日 YYYY-MM-DD，优先用于界面展示"
                  }
                }
              },
              "accountRank": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "115 账号等级"
              },
              "space": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "上次成功取得的空间数据",
                "properties": {
                  "total": {
                    "type": [
                      "string"
                    ],
                    "description": "总字节数，十进制字符串"
                  },
                  "used": {
                    "type": [
                      "string"
                    ],
                    "description": "已用字节数"
                  },
                  "free": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "剩余字节数"
                  },
                  "syncedAt": {
                    "type": [
                      "integer"
                    ],
                    "description": "Unix 毫秒"
                  }
                }
              },
              "syncedAt": {
                "type": [
                  "integer"
                ],
                "description": "Unix 毫秒"
              },
              "issues": {
                "type": [
                  "array"
                ],
                "description": "本次未取得的项目",
                "items": {
                  "type": [
                    "string"
                  ],
                  "description": "空间或头像",
                  "enum": [
                    "space",
                    "avatar"
                  ]
                }
              }
            }
          }
        },
        "required": []
      }
    },
    "example": {
      "args": {},
      "result": [
        {
          "uuid": "12345",
          "kind": "cookie",
          "label": "主账号",
          "note": "",
          "updated": 1
        }
      ]
    }
  },
